APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8088

DATABASE_URL=sqlite:////data/db/djgabo_engine.db
REDIS_URL=redis://redis:6379/0

YOUTUBE_MODE=mock
YOUTUBE_DEFAULT_PRIVACY=unlisted
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8088

DEFAULT_CUT_SECONDS=80
AUDIO_CROSSFADE_SECONDS=0.25
OUTPUT_WIDTH=1280
OUTPUT_HEIGHT=720
AUDIO_BITRATE=256k
AUDIO_SAMPLE_RATE=48000

MAX_UPLOADS_PER_CHANNEL_24H=7
RENDER_CONCURRENCY=1
UPLOAD_CONCURRENCY=1
READY_BUFFER=4

SUCCESS_RETENTION_MINUTES=60
FAILED_RETENTION_DAYS=7
MAX_UPLOAD_FILE_MB=500

DATA_ROOT=/data
INCOMING_DIR=/data/incoming
PROCESSING_DIR=/data/processing
READY_DIR=/data/ready
ASSETS_DIR=/data/assets
FAILED_DIR=/data/failed
